# Copy to .env and fill in. Never commit the real .env — .gitignore covers .env*

# GitHub API token — strongly recommended.
# Without it you get 60 requests/hour per IP, SHARED ACROSS ALL VISITORS, and
# the /github page will fail under any real traffic. With it: 5,000/hour.
# Create a fine-grained token with NO scopes (public data only) at:
#   https://github.com/settings/personal-access-tokens/new
GITHUB_TOKEN=

# Optional. Canonical origin for metadata, OG tags, sitemap and robots.
# Defaults to https://www.hrshkshri.com when unset.
NEXT_PUBLIC_SITE_URL=
